import { createFileRoute, Link, notFound } from "@tanstack/react-router";
import { useEffect, useState } from "react";

import { getBrand } from "@/lib/projects";
import heroSliderImg from "@/assets/3sliderpost.jpg";
const extendedLogo = "/assets/esummitidentity-BCxZkC8M.png";
const palette = [
  { name: "MIDNIGHT / SPACE", hex: "#05091F", note: "Primary background colour. Use for the deepest backgrounds and large negative-space areas." },
  { name: "DEEP NAVY", hex: "#071B4A", note: "Secondary background. This should dominate the darker E-Summit surfaces." },
  { name: "ROYAL INDIGO", hex: "#252B9B", note: "Main indigo/blue gradient areas and UI/card surfaces." },
  { name: "ELECTRIC BLUE", hex: "#0878E8", note: "Primary energetic accent, buttons, highlights and important visual details." },
  { name: "VIOLET", hex: "#6946D8", note: "Use sparingly for gradients, glow effects and secondary accents." },
  { name: "CYAN", hex: "#25C7FF", note: "Luminous highlights, thin lines, glow and futuristic details." },
  { name: "FEATHER ORANGE", hex: "#FF7A24", note: "Small accent inspired by the feather motif; never dominant." },
  { name: "GOLD", hex: "#FFC857", note: "Very sparing highlights reflecting warm golden particles in the feather artwork." },
  { name: "WHITE", hex: "#FFFFFF", note: "Primary text and high-contrast elements." },
  { name: "SOFT BLUE-WHITE", hex: "#D9E5FF", note: "Secondary text instead of using pure white everywhere." },
] as const;
const countdownFeather = "/assets/100dayss-B5LqMzPy.png";
const countdownWings = "/assets/50days-BKpnH9LG.png";
const countdownPhoenix = "/assets/1day-Bu-AmyCf.png";
